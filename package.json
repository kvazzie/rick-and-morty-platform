{
  "name": "rick-and-morty-platform",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rick-and-morty-platform/web dev",
    "generate-pwa-assets": "pnpm --filter @rick-and-morty-platform/web generate-pwa-assets",
    "build": "pnpm --filter @rick-and-morty-platform/web build",
    "lint": "pnpm --filter @rick-and-morty-platform/web lint",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "pnpm test:environment",
    "test:environment": "bash scripts/test-environment.sh",
    "preview": "pnpm --filter @rick-and-morty-platform/web preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.57.0",
    "semantic-release": "^25.0.5"
  },
  "packageManager": "pnpm@10.29.3"
}
